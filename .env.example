# Polling interval in seconds (minimum 30)
MONITOR_INTERVAL_SECONDS=300
# Comma-separated trusted origins for a separate frontend (empty = same-origin only)
CORS_ORIGINS=

# Optional first-run administrator bootstrap. Keep both empty to use the setup page.
# Password must be 12–256 characters. These values are only used when no admin exists.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Set true when a reverse proxy terminates HTTPS before this container.
AUTH_COOKIE_SECURE=
